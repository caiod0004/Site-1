---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource/instrument-serif/400.css';
import '../styles/global.css';
import displayFont from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import { SITE_URL, IUBENDA, GOOGLE_ANALYTICS } from '../config';

interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  jsonLd?: object[];
  /** Tema della pagina: 'home' | 'sito' | 'diagnosi' | 'consulenza' */
  theme?: string;
  /** Immagine Open Graph (percorso in /public), default /og-image.jpg */
  og?: string;
  ogType?: string;
  themeColor?: string;
}
const { title, description, path = '/', noindex = false, jsonLd = [], theme = 'diagnosi', og = '/og-image.jpg', ogType = 'website', themeColor = '#2A2A26' } = Astro.props;
const canonical = new URL(path, SITE_URL).href;
const ogImage = new URL(og, SITE_URL).href;
const consentOn = IUBENDA.enabled && IUBENDA.siteId && IUBENDA.cookiePolicyId;
const gaOn = consentOn && GOOGLE_ANALYTICS.enabled && GOOGLE_ANALYTICS.measurementId;
---
<!doctype html>
<html lang="it" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#211d1a" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Diario dal laboratorio" href="/blog/rss.xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="Caio Machado" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    {/*
      ── PUNTO DI INSERIMENTO PRIVACY ──
      Iubenda e Google Analytics sono SPENTI (src/config.ts).
      Quando li accendi, GA viene caricato come type="text/plain" e lo attiva
      Iubenda solo dopo il consenso (blocco preventivo, finalità 4 = misurazione).
    */}
    {consentOn && (
      <>
        <script type="text/javascript" set:html={`var _iub=_iub||[];_iub.csConfiguration={siteId:${Number(IUBENDA.siteId)},cookiePolicyId:${Number(IUBENDA.cookiePolicyId)},lang:"it",perPurposeConsent:true,enableTcf:false,banner:{position:"float-bottom-center",acceptButtonDisplay:true,rejectButtonDisplay:true,customizeButtonDisplay:true}};`} />
        <script type="text/javascript" src={`https://cs.iubenda.com/autoblocking/${IUBENDA.siteId}.js`} />
        <script type="text/javascript" src="https://cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async />
      </>
    )}
    {gaOn && (
      <>
        <script type="text/plain" class="_iub_cs_activate" data-iub-purposes="4" data-suppressedsrc={`https://www.googletagmanager.com/gtag/js?id=${GOOGLE_ANALYTICS.measurementId}`} async />
        <script type="text/plain" class="_iub_cs_activate-inline" data-iub-purposes="4" set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','${GOOGLE_ANALYTICS.measurementId}',{anonymize_ip:true});`} />
      </>
    )}
  </head>
  <body>
    <a href="#contenuto" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-lime focus:px-5 focus:py-3 focus:text-ink">Vai al contenuto</a>
    <slot />
    <script is:inline>
      // Rivelazioni allo scroll e parallasse leggero (solo se il movimento è consentito)
      (function () {
        if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) return;
        var root = document.documentElement; root.classList.add('js-motion');
        document.querySelectorAll('[data-stagger]').forEach(function (g) { Array.prototype.forEach.call(g.children, function (c, i) { c.style.setProperty('--i', i); }); });
        var io = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px' });
        document.querySelectorAll('[data-reveal],[data-stagger]').forEach(function (el) { io.observe(el); });
        var px = [].slice.call(document.querySelectorAll('[data-parallax]')); if (!px.length) return;
        var tick = false;
        function upd() { tick = false; var vh = innerHeight; px.forEach(function (el) { var r = el.parentElement.getBoundingClientRect(); if (r.bottom < 0 || r.top > vh) return; var k = parseFloat(el.dataset.parallax) || 0.12; var c = (r.top + r.height / 2 - vh / 2); el.style.transform = 'translate3d(0,' + (c * -k).toFixed(1) + 'px,0) scale(1.12)'; }); }
        addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(upd); } }, { passive: true });
        upd();
      })();
      addEventListener('load', function () {
        setTimeout(function () { document.documentElement.classList.add('ready'); }, 1800);
      });
    </script>
  </body>
</html>

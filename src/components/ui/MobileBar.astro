---
import Icon from './Icon.astro';
interface Props { href: string; label: string; price?: string; hideAt?: string; showAfter?: string; external?: boolean }
/** hideAt: id (anche più di uno, separati da virgola) delle sezioni in cui la barra sparisce */
const { href, label, price, hideAt = 'chiusura', showAfter = 'top', external = false } = Astro.props;
const ext = external ? { target: '_blank', rel: 'noopener' } : {};
---
<div id="mobile-bar" class="fixed inset-x-0 bottom-0 z-40 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 lg:hidden" data-show="false" data-hide-at={hideAt} data-show-after={showAfter}>
  <a href={href} {...ext} class="btn btn-ink w-full !min-h-[3.4rem] justify-between !px-6 shadow-[0_18px_40px_-10px_rgb(0_0_0/0.6)]">
    <span>{label}</span>
    <span class="flex items-center gap-2">{price && <span class="font-serif text-[1.25rem] italic">{price}</span>}<Icon name="arrow-right" /></span>
  </a>
</div>
<style>
  #mobile-bar { transform: translateY(120%); transition: transform 0.5s var(--ease-out-soft); }
  #mobile-bar[data-show='true'] { transform: none; }
</style>
<script>
  const bar = document.getElementById('mobile-bar')!;
  const after = document.getElementById(bar.dataset.showAfter || 'top');
  const ends = (bar.dataset.hideAt || '').split(',').map((id) => document.getElementById(id.trim())).filter(Boolean) as HTMLElement[];
  let past = false; const inside = new Set<Element>();
  const sync = () => { const show = past && inside.size === 0; bar.dataset.show = String(show); bar.inert = !show; };
  let tick = false;
  const check = () => { tick = false; past = after ? after.getBoundingClientRect().bottom < 0 : scrollY > innerHeight * 0.8; sync(); };
  addEventListener('scroll', () => { if (!tick) { tick = true; requestAnimationFrame(check); } }, { passive: true });
  check();
  const io = new IntersectionObserver((es) => { es.forEach((e) => (e.isIntersecting ? inside.add(e.target) : inside.delete(e.target))); sync(); }, { rootMargin: '0px 0px -25% 0px' });
  ends.forEach((el) => io.observe(el));
  sync();
</script>

---
import Monogram from './Monogram.astro';
import Icon from './Icon.astro';
export interface NavItem { href: string; label: string }
interface Props {
  nav?: NavItem[];
  cta?: { href: string; label: string; short?: string; external?: boolean };
  sub?: string;
}
const { nav = [], cta, sub = 'Ristorazione e tecnologia' } = Astro.props;
const ext = cta?.external ? { target: '_blank', rel: 'noopener' } : {};
---
<header id="site-header" class="on-paper fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,backdrop-filter] duration-500" data-scrolled="false">
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4">
    <a href="/" class="flex min-h-11 items-center gap-3">
      <Monogram />
      <span class="whitespace-nowrap font-display text-[0.98rem] leading-tight tracking-[-0.01em]">
        <span class="font-medium text-paper-ink">Caio Machado</span>
        <span class="hidden text-paper-muted sm:inline"> · {sub}</span>
        <span class="sr-only">, vai alla home</span>
      </span>
    </a>
    {nav.length > 0 && (
      <nav aria-label="Sezioni della pagina" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {nav.map((n) => (
            <li><a href={n.href} class="inline-flex min-h-11 items-center rounded-full px-4 font-display text-[0.95rem] text-paper-ink/80 transition-colors hover:text-lime-deep">{n.label}</a></li>
          ))}
        </ul>
      </nav>
    )}
    {cta && (
      <a href={cta.href} {...ext} class="btn btn-ink !min-h-11 shrink-0 whitespace-nowrap !px-4 !text-[0.95rem] sm:!px-5">
        <span class="sm:hidden">{cta.short ?? cta.label}</span><span class="hidden sm:inline">{cta.label}</span>
        <Icon name="arrow-right" />
      </a>
    )}
  </div>
</header>
<style>
  #site-header[data-scrolled='true'] {
    background-color: color-mix(in srgb, var(--color-paper) 84%, transparent);
    backdrop-filter: blur(16px) saturate(160%);
    -webkit-backdrop-filter: blur(16px) saturate(160%);
    box-shadow: 0 1px 0 color-mix(in srgb, var(--color-paper-ink) 12%, transparent);
  }
</style>
<script>
  const h = document.getElementById('site-header')!;
  let on = false;
  const set = () => { const s = window.scrollY > 24; if (s !== on) { on = s; h.dataset.scrolled = String(s); } };
  set();
  window.addEventListener('scroll', set, { passive: true });
</script>

---
export interface FaqItem { q: string; a: string }
interface Props { items: FaqItem[]; id?: string; titleHtml?: string }
const { items, id = 'faq', titleHtml = 'Domande <span class="em">frequenti.</span>' } = Astro.props;
---
<section id={id} class="on-paper bg-paper text-paper-ink" aria-labelledby={`${id}-t`}>
  <div class="wrap grid gap-12 py-24 sm:py-32 lg:grid-cols-[0.75fr_1.25fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id={`${id}-t`} class="t-h2" set:html={titleHtml} />
    </div>
    <div class="border-b border-paper-ink/15">
      {items.map((f) => (
        <details class="faq group border-t border-paper-ink/15">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-6 font-display text-[1.1rem] font-medium leading-snug tracking-[-0.015em] sm:text-[1.25rem] [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="relative grid size-9 shrink-0 place-items-center rounded-full border border-paper-ink/25 transition-colors duration-300 group-open:border-paper-ink group-open:bg-paper-ink group-open:text-paper" aria-hidden="true">
              <span class="absolute h-[1.5px] w-3.5 bg-current"></span>
              <span class="absolute h-3.5 w-[1.5px] bg-current transition-transform duration-300 group-open:rotate-90 group-open:scale-y-0"></span>
            </span>
          </summary>
          <div><p class="max-w-[40rem] pb-7 pr-12 text-paper-muted" set:html={f.a.replace(/\[([^\]]+)\]/g, '<span class="placeholder">[$1]</span>')} /></div>
        </details>
      ))}
    </div>
  </div>
</section>
<style>
  @supports (interpolate-size: allow-keywords) {
    .faq { interpolate-size: allow-keywords; }
    .faq::details-content { height: 0; overflow: clip; transition: height 0.45s var(--ease-out-soft), content-visibility 0.45s allow-discrete; }
    .faq[open]::details-content { height: auto; }
  }
</style>

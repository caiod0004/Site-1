---
/** Impaginazione comune per Privacy e Cookie. */
import Base from '../../layouts/Base.astro';
import Monogram from './Monogram.astro';
import { LEGALE } from '../../config';
interface Props { title: string; description: string; path: string; updated: string }
const { title, description, path, updated } = Astro.props;
---
<Base title={`${title} | Caio Machado`} description={description} path={path} theme="home">
  <main id="contenuto" class="on-paper min-h-[80vh] bg-paper text-paper-ink">
    <div class="wrap py-16 sm:py-24">
      <a href="/" class="inline-flex min-h-11 items-center gap-3 font-display"><Monogram /> Torna alla pagina principale</a>
      <h1 class="t-h2 mt-14">{title}</h1>
      <p class="mt-4 text-[0.9rem] text-paper-muted">Ultimo aggiornamento: {updated}</p>
      <div class="legal mt-12 max-w-[46rem]">
        <slot />
      </div>
      <p class="mt-16 text-[0.85rem] text-paper-muted">{LEGALE}</p>
    </div>
  </main>
</Base>
<style>
  .legal :global(h2) { font-family: var(--font-display, inherit); font-weight: 600; font-size: 1.25rem; margin-top: 2.6rem; }
  .legal :global(p), .legal :global(li) { margin-top: 0.9rem; line-height: 1.65; color: rgb(42 42 38 / 0.82); }
  .legal :global(ul) { list-style: disc; padding-left: 1.3rem; }
  .legal :global(a) { text-decoration: underline; text-underline-offset: 4px; }
  .legal :global(table) { width: 100%; margin-top: 1rem; border-collapse: collapse; font-size: 0.95rem; }
  .legal :global(th), .legal :global(td) { border-bottom: 1px solid rgb(42 42 38 / 0.12); padding: 0.6rem 0.4rem; text-align: left; vertical-align: top; }
</style>

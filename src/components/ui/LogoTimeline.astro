---
/**
 * Percorso professionale: i marchi delle cucine in cui Caio ha lavorato.
 * Ogni tappa ha una "scheda" con il logo, il numero d'ordine e il ruolo.
 * Allo scroll la linea si riempie e la tappa raggiunta si accende.
 */
import { Image } from 'astro:assets';
export interface LogoItem { logo: ImageMetadata; alt: string; nome: string; ruolo?: string; dove?: string; testo: string; h?: string; oggi?: boolean }
interface Props { items: LogoItem[] }
const { items } = Astro.props;
---
<ol class="logo-tl relative" data-logotl>
  <span class="lrail absolute bottom-16 left-[4.4rem] top-16 w-px bg-current opacity-15 sm:left-[6.4rem]" aria-hidden="true"></span>
  <span class="lrail-fill absolute bottom-16 left-[4.4rem] top-16 w-px origin-top bg-lime-deep sm:left-[6.4rem]" aria-hidden="true"></span>
  {items.map((it, i) => (
    <li class:list={['lstep relative grid grid-cols-[8.8rem_1fr] items-center gap-5 pb-12 last:pb-0 sm:grid-cols-[12.8rem_1fr] sm:gap-9', { 'is-oggi': it.oggi }]} data-lstep>
      <span class="tile relative z-10 grid aspect-[5/4] w-full place-items-center overflow-hidden rounded-[1.35rem] p-4 sm:p-6">
        <span class="num pointer-events-none absolute -right-1 -top-3 font-serif text-[3.4rem] leading-none sm:text-[4.6rem]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        <Image src={it.logo} alt={it.alt} widths={[240, 480]} sizes="13rem" class={`logo relative w-auto max-w-full object-contain ${it.h ?? 'max-h-14 sm:max-h-20'}`} loading="lazy" />
        <span class="dot absolute -right-[0.42rem] top-1/2 hidden h-3 w-3 -translate-y-1/2 rounded-full" aria-hidden="true"></span>
      </span>
      <div class="txt">
        <div class="flex flex-wrap items-center gap-2">
          {it.ruolo && <span class="chip rounded-full px-3 py-1 font-display text-[0.72rem] uppercase tracking-[0.12em]">{it.ruolo}</span>}
          {it.dove && <span class="font-display text-[0.86rem] text-lime-deep">{it.dove}</span>}
        </div>
        <h3 class="t-h3 mt-3 !text-[clamp(1.2rem,1rem+0.7vw,1.6rem)]">{it.nome}</h3>
        <p class="mt-2 max-w-[36rem] text-[0.98rem] text-paper-muted">{it.testo}</p>
      </div>
    </li>
  ))}
</ol>
<style>
  .lrail-fill { transform: scaleY(var(--p, 0)); }
  .tile {
    background: linear-gradient(150deg, #fbfbf1 0%, #ecebd3 100%);
    box-shadow: inset 0 0 0 1px rgb(42 42 38 / 0.09), 0 18px 34px -30px rgb(42 42 38 / 0.6);
    transition: transform 0.7s var(--ease-out-soft), box-shadow 0.7s var(--ease-out-soft), background 0.7s var(--ease-out-soft);
  }
  .num { color: rgb(42 42 38 / 0.06); transition: color 0.7s var(--ease-out-soft); }
  .logo { opacity: 0.38; filter: grayscale(1) contrast(0.9); transform: scale(0.94); transition: opacity 0.7s var(--ease-out-soft), filter 0.7s var(--ease-out-soft), transform 0.7s var(--ease-out-soft); }
  .chip { background: rgb(42 42 38 / 0.06); color: rgb(42 42 38 / 0.7); transition: background 0.6s var(--ease-out-soft), color 0.6s var(--ease-out-soft); }
  .txt { opacity: 0.55; transform: translateX(6px); transition: opacity 0.7s var(--ease-out-soft), transform 0.7s var(--ease-out-soft); }

  .lstep.on .tile {
    background: #fff;
    transform: translateY(-3px) rotate(-1deg);
    box-shadow: 0 0 0 2px var(--color-lime), 0 30px 50px -28px rgb(31 95 122 / 0.55);
  }
  .lstep.on:nth-child(even) .tile { transform: translateY(-3px) rotate(1deg); }
  .lstep.on .num { color: rgb(95 177 209 / 0.22); }
  .lstep.on .logo { opacity: 1; filter: none; transform: scale(1); }
  .lstep.on .chip { background: var(--color-lime); color: #17323d; }
  .lstep.on .txt { opacity: 1; transform: none; }
  .lstep.on.is-oggi .tile { box-shadow: 0 0 0 2px #e4606c, 0 30px 50px -28px rgb(228 96 108 / 0.5); }
  .lstep.on.is-oggi .chip { background: #e4606c; color: #fff; }

  @media (hover: hover) {
    .lstep:hover .logo { opacity: 1; filter: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lrail-fill { transform: scaleY(1); }
    .logo, .txt { opacity: 1; filter: none; transform: none; }
  }
</style>
<script>
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<HTMLElement>('[data-logotl]').forEach((tl) => {
    const fill = tl.querySelector<HTMLElement>('.lrail-fill')!;
    const steps = [...tl.querySelectorAll<HTMLElement>('[data-lstep]')];
    if (calm) { steps.forEach((s) => s.classList.add('on')); return; }
    let ticking = false, visible = false;
    const update = () => {
      ticking = false;
      const r = fill.getBoundingClientRect(); const line = innerHeight * 0.62;
      fill.style.setProperty('--p', Math.min(1, Math.max(0, (line - r.top) / r.height)).toFixed(4));
      steps.forEach((s) => { const t = s.querySelector<HTMLElement>('.tile')!.getBoundingClientRect(); s.classList.toggle('on', t.top + t.height / 2 < line); });
    };
    const onScroll = () => { if (visible && !ticking) { ticking = true; requestAnimationFrame(update); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) onScroll(); }).observe(tl);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
  });
</script>

---
import Icon from './Icon.astro';
const si = ['Hai una piccola attività (ristorante, negozio, studio, servizio) e ti serve un sito chiaro, presto.', 'Preferisci partire semplice e crescere dopo.', 'Puoi mandarmi testi e foto in pochi giorni.'];
const no = ['Ti serve un e-commerce, un sito di molte pagine o funzioni su misura (si può fare, ma non a 197 €).', 'Cerchi qualcuno che ti garantisca un numero di clienti in più.', 'Non hai tempo di mandare il materiale.'];
---
<section class="border-t border-gold/15 bg-ink" aria-labelledby="perchi-t">
  <div class="wrap py-24 sm:py-32">
    <h2 id="perchi-t" class="t-h2">Per chi è, <span class="em text-ivory/70">e per chi non è.</span></h2>
    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <div class="rounded-[1.75rem] bg-ink-2 p-7 shadow-[inset_0_0_0_1px_rgb(214_178_106/0.3)] sm:p-10">
        <h3 class="t-h3 text-gold-light">È per te se</h3>
        <ul class="mt-7 space-y-5">
          {si.map((t) => <li class="flex gap-4"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-gold text-ink"><Icon name="check" class="size-4" stroke={2.25} /></span><span class="text-ivory/85">{t}</span></li>)}
        </ul>
      </div>
      <div class="rounded-[1.75rem] p-7 shadow-[inset_0_0_0_1px_rgb(243_238_228/0.12)] sm:p-10">
        <h3 class="t-h3 text-ivory/85">Non è per te se</h3>
        <ul class="mt-7 space-y-5">
          {no.map((t) => <li class="flex gap-4"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full border border-ivory/25 text-ivory/60"><Icon name="x" class="size-4" stroke={2} /></span><span class="text-ivory/70">{t}</span></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

---
const passi = [
  { t: 'Compili il questionario.', d: '5 minuti: la tua attività, cosa deve fare il sito, cosa hai già (dominio, foto, testi).' },
  { t: 'Paghi e prenoti la prima chiamata.', d: '197 €. In 30 minuti mettiamo in fila contenuti e obiettivo.' },
  { t: 'Il sito va online.', d: 'Entro 7 giorni lavorativi da quando ho tutto il materiale.' },
  { t: 'Chiamata di consegna.', d: 'Ti mostro il sito, facciamo le ultime modifiche e ti spiego cosa puoi fare dopo.' },
];
---
<section id="come-funziona" class="relative overflow-hidden bg-ink pb-40 sm:pb-48 lg:pb-64" aria-labelledby="funziona-t">
  <span class="pointer-events-none absolute -right-[0.08em] top-10 select-none font-display text-[clamp(16rem,42vw,40rem)] font-medium leading-none tracking-[-0.08em] text-transparent [-webkit-text-stroke:1px_rgb(214_178_106/0.16)]" aria-hidden="true">7</span>
  <div class="wrap relative grid gap-14 pt-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="t-kicker text-gold">Come funziona</p>
      <h2 id="funziona-t" class="t-h2 mt-4">Quattro passi. <span class="em gold-sheen">Sette giorni.</span></h2>
    </div>
    <ol class="timeline relative" data-timeline>
      <span class="rail absolute bottom-6 left-[1.4rem] top-6 w-px bg-ivory/12" aria-hidden="true">
        <span class="fill absolute inset-0 origin-top bg-gradient-to-b from-gold-light to-gold"></span>
      </span>
      {passi.map((p, i) => (
        <li class="step relative grid grid-cols-[2.8rem_1fr] gap-6 pb-14 last:pb-0" data-step>
          <span class="dot relative z-10 grid size-[2.8rem] place-items-center rounded-full border border-ivory/20 bg-ink font-display text-[1.05rem] text-ivory/70 transition-colors duration-500">{i + 1}</span>
          <div class="pt-1.5">
            <h3 class="t-h3 !text-[clamp(1.35rem,1.1rem+1vw,1.9rem)]">{p.t}</h3>
            <p class="mt-3 max-w-[32rem] text-ivory/75">{p.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .fill { transform: scaleY(var(--p, 0)); }
  .step.on .dot { border-color: var(--color-gold); background: var(--color-gold); color: var(--color-ink); }
  @media (prefers-reduced-motion: reduce) {
    .fill { transform: scaleY(1); }
    .step .dot { border-color: var(--color-gold); color: var(--color-gold); }
  }
</style>
<script>
  const tl = document.querySelector<HTMLElement>('[data-timeline]');
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (tl && !calm) {
    const fill = tl.querySelector<HTMLElement>('.fill')!;
    const rail = tl.querySelector<HTMLElement>('.rail')!;
    const steps = [...tl.querySelectorAll<HTMLElement>('[data-step]')];
    let ticking = false, visible = false;
    const update = () => {
      ticking = false;
      const r = rail.getBoundingClientRect();
      const line = window.innerHeight * 0.62;
      const p = Math.min(1, Math.max(0, (line - r.top) / r.height));
      fill.style.setProperty('--p', p.toFixed(4));
      steps.forEach((s) => {
        const d = s.querySelector<HTMLElement>('.dot')!.getBoundingClientRect();
        s.classList.toggle('on', d.top + d.height / 2 < line);
      });
    };
    const onScroll = () => { if (visible && !ticking) { ticking = true; requestAnimationFrame(update); } };
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; if (visible) onScroll(); }).observe(tl);
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }
</script>

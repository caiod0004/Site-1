---
import { VANTAGGI } from '../data/content';
const row = [...VANTAGGI, ...VANTAGGI];
---
<div class="relative border-t border-gold/20 bg-ink-2 pb-2 pt-5" role="region" aria-label="Vantaggi in breve">
  <ul class="sr-only">{VANTAGGI.map((v) => <li>{v}</li>)}</ul>
  <div class="marquee flex overflow-hidden [mask-image:linear-gradient(90deg,transparent,#000_8%,#000_92%,transparent)]" aria-hidden="true">
    <div class="track flex shrink-0 items-center">
      {row.map((v) => (
        <span class="flex items-center whitespace-nowrap font-display text-[1.15rem] tracking-[-0.01em] text-ivory/85 sm:text-[1.35rem]">
          <span class="px-6 sm:px-9">{v}</span>
          <svg viewBox="0 0 12 12" class="size-3 text-gold" fill="currentColor"><path d="M6 0l1.4 4.6L12 6l-4.6 1.4L6 12 4.6 7.4 0 6l4.6-1.4z" /></svg>
        </span>
      ))}
    </div>
  </div>
</div>
<style>
  @media (prefers-reduced-motion: no-preference) {
    :global(.ready) .track { animation: marquee 38s linear infinite; }
    .marquee:hover .track { animation-play-state: paused; }
  }
  @keyframes marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { flex-wrap: wrap; justify-content: center; row-gap: 0.5rem; }
  }
</style>

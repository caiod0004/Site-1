---
const frasi = [
  'Il sito non ce l’hai, oppure c’è ma ti vergogni a mandarlo.',
  'Chi ti cerca su Google trova orari vecchi, un numero sbagliato o niente.',
  'Ti hanno chiesto mille euro e più per un sito, e hai lasciato perdere.',
  'Hai provato a farlo da solo una sera, e sei rimasto a metà.',
  'Vivi solo di Instagram e passaparola, e ogni tanto ti chiedi cosa succederebbe se domani sparissero.',
];
---
<section class="on-paper bg-paper text-paper-ink" aria-labelledby="riconosci-t">
  <div class="wrap grid gap-12 pb-24 pt-14 sm:pb-28 lg:grid-cols-[0.9fr_1.1fr] lg:gap-20 lg:pb-36 lg:pt-20">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <p class="t-kicker text-lime-deep">Ti riconosci?</p>
      <h2 data-reveal id="riconosci-t" class="t-h2 mt-4">Se ti ritrovi anche in <span class="em">una sola</span> di queste frasi, continua a leggere.</h2>
    </div>
    <fieldset>
      <legend class="sr-only">Segna le frasi in cui ti ritrovi</legend>
      <ul class="border-b border-paper-ink/15">
        {frasi.map((f) => (
          <li class="border-t border-paper-ink/15">
            <label class="group flex cursor-pointer items-start gap-5 py-6 sm:py-7">
              <input type="checkbox" class="peer sr-only" />
              <span class="tick mt-1 grid size-7 shrink-0 place-items-center rounded-md border-[1.5px] border-paper-ink/35 transition-colors duration-300 group-hover:border-lime-deep peer-checked:border-lime-deep peer-checked:bg-lime-deep peer-focus-visible:outline-2 peer-focus-visible:outline-offset-3 peer-focus-visible:outline-lime-deep" aria-hidden="true">
                <svg viewBox="0 0 16 16" class="size-4 text-paper" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7" /></svg>
              </span>
              <span class="font-display text-[1.2rem] leading-snug tracking-[-0.015em] sm:text-[1.45rem]">{f}</span>
            </label>
          </li>
        ))}
      </ul>
      <p class="mt-5 text-[0.95rem] text-paper-muted">Puoi segnarle: non viene salvato né inviato niente.</p>
    </fieldset>
  </div>
</section>
<style>
  .tick svg { stroke-dasharray: 16; stroke-dashoffset: 16; transition: stroke-dashoffset 0.4s var(--ease-out-soft) 0.05s; }
  input:checked + .tick svg { stroke-dashoffset: 0; }
</style>

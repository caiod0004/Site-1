---
import Icon from '../ui/Icon.astro';
---
<figure class="phone-scene relative mx-auto w-[min(78vw,300px)] md:w-[260px] lg:w-[340px] select-none" aria-label="Esempio di struttura di un sito di una pagina, visto da telefono">
  <figcaption class="absolute -top-3 left-1/2 z-20 -translate-x-1/2 whitespace-nowrap rounded-full border border-[#2a2a26] bg-[#2a2a26] px-3.5 py-1.5 font-display text-[0.8rem] text-[#f1f1db]">
    Esempio di struttura
  </figcaption>
  <div class="phone" data-tilt>
    <div class="phone-screen" aria-hidden="true">
      <div class="b" style="--i:0">
        <div class="flex items-center gap-2">
          <span class="grid size-6 place-items-center rounded-full bg-[#2a2a26] text-[0.55rem] font-semibold text-[#f1f1db]">N</span>
          <div class="leading-tight">
            <p class="text-[0.7rem] font-semibold text-[#2a2a26]">Nome attività</p>
            <p class="text-[0.55rem] text-[#6e6456]">Città · settore</p>
          </div>
          <span class="ml-auto h-1.5 w-5 rounded-full bg-[#2a2a26]/20"></span>
        </div>
      </div>
      <div class="b hero-b" style="--i:1">
        <p class="font-display text-[0.95rem] font-medium leading-[1.05] tracking-[-0.03em] text-[#f1f1db]">Chi sei,<br />in una frase.</p>
        <span class="mt-2 block h-1 w-24 rounded-full bg-[#f1f1db]/40"></span>
        <span class="mt-1 block h-1 w-16 rounded-full bg-[#f1f1db]/30"></span>
      </div>
      <div class="b grid grid-cols-2 gap-1.5" style="--i:2">
        <span class="chip bg-[#2a2a26] text-[#f1f1db]"><Icon name="phone" class="size-3" stroke={2} />Chiama</span>
        <span class="chip bg-[#1f5c3f] text-[#f1f1db]"><Icon name="message-circle" class="size-3" stroke={2} />WhatsApp</span>
      </div>
      <div class="b" style="--i:3">
        <span class="chip w-full border border-[#2a2a26]/25 text-[#2a2a26]"><Icon name="calendar-check" class="size-3" stroke={2} />Prenota o chiedi un preventivo</span>
      </div>
      <div class="b" style="--i:4">
        <p class="mb-1.5 text-[0.62rem] font-semibold text-[#2a2a26]">Cosa offriamo</p>
        {[64, 48, 56].map((w) => (
          <div class="flex items-center justify-between border-t border-[#2a2a26]/10 py-[5px]">
            <span class="h-1.5 rounded-full bg-[#2a2a26]/25" style={`width:${w}%`}></span>
            <span class="h-1.5 w-6 rounded-full bg-coral/70"></span>
          </div>
        ))}
      </div>
      <div class="b grid grid-cols-3 gap-1" style="--i:5">
        <span class="ph" style="--h:28"></span><span class="ph" style="--h:12"></span><span class="ph" style="--h:40"></span>
      </div>
      <div class="b grid grid-cols-[auto_1fr] gap-x-3 gap-y-1 text-[0.56rem] text-[#6e6456]" style="--i:6">
        <p class="col-span-2 text-[0.62rem] font-semibold text-[#2a2a26]">Orari</p>
        <span>Lun – Ven</span><span class="mt-1 h-1.5 w-14 rounded-full bg-[#2a2a26]/20"></span>
        <span>Sab – Dom</span><span class="mt-1 h-1.5 w-10 rounded-full bg-[#2a2a26]/20"></span>
      </div>
      <div class="b map" style="--i:7">
        <svg viewBox="0 0 240 70" class="h-full w-full" preserveAspectRatio="xMidYMid slice">
          <rect width="240" height="70" fill="#e4dccb" />
          <path d="M-5 50 C 60 40, 90 62, 150 36 S 230 20, 250 28" stroke="#fff" stroke-width="6" fill="none" />
          <path d="M70 -5 L 95 75 M 170 -5 L 150 75" stroke="#fff" stroke-width="3.5" fill="none" />
          <path d="M120 22 c0 -7 -5 -11 -10 -11 s-10 4 -10 11 c0 7 10 16 10 16 s10 -9 10 -16z" fill="#211d1a" />
          <circle cx="110" cy="21" r="3.2" fill="#f0f1dc" />
        </svg>
        <p class="absolute bottom-1.5 left-2 rounded bg-[#f1f1db]/90 px-1.5 py-0.5 text-[0.52rem] font-semibold text-[#2a2a26]">Mappa</p>
      </div>
    </div>
    <span class="phone-notch" aria-hidden="true"></span>
    <span class="phone-glare" aria-hidden="true"></span>
  </div>
</figure>

<style>
  .phone-scene { perspective: 1100px; }
  .phone {
    --rx: 6deg; --ry: -14deg;
    position: relative;
    aspect-ratio: 300 / 612;
    border-radius: 46px;
    padding: 11px;
    background: linear-gradient(145deg, #2a2630, #0e0d12 45%, #1c1920);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.25),
      0 0 0 2px #050407,
      inset 0 0 0 1.5px rgb(255 255 255 / 0.06),
      0 50px 90px -30px rgb(0 0 0 / 0.9),
      0 30px 60px -30px rgb(33 29 26 / 0.45);
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transform-style: preserve-3d;
    will-change: transform;
  }
  .phone-screen {
    position: relative;
    height: 100%;
    border-radius: 36px;
    overflow: hidden;
    background: #fbfbf4;
    padding: 34px 12px 12px;
    display: flex; flex-direction: column; gap: 8px;
    font-family: var(--font-sans);
  }
  .phone-notch {
    position: absolute; top: 19px; left: 50%; width: 78px; height: 22px;
    transform: translateX(-50%); border-radius: 999px; background: #050407;
  }
  .phone-glare {
    position: absolute; inset: 11px; border-radius: 36px; pointer-events: none;
    background: linear-gradient(115deg, rgb(255 255 255 / 0.22) 0%, rgb(255 255 255 / 0) 32%, rgb(255 255 255 / 0) 70%, rgb(255 255 255 / 0.06) 100%);
    mix-blend-mode: soft-light;
  }
  .b { position: relative; border-radius: 10px; }
  .hero-b {
    padding: 14px 12px 12px; min-height: 104px; display: flex; flex-direction: column; justify-content: flex-end;
    background:
      radial-gradient(120% 90% at 85% 10%, rgb(139 198 224 / 0.85), transparent 60%),
      linear-gradient(160deg, #3d6f86, #1f3a47);
  }
  .chip {
    display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    height: 28px; border-radius: 999px; font-size: 0.6rem; font-weight: 600;
  }
  .ph { aspect-ratio: 1; border-radius: 8px; background: linear-gradient(150deg, hsl(var(--h) 30% 72%), hsl(var(--h) 22% 52%)); }
  .map { height: 64px; overflow: hidden; }

  /* Le sezioni si "costruiscono": prima la struttura tratteggiata, poi il contenuto */
  .b::after {
    content: ''; position: absolute; inset: -2px; border-radius: 11px;
    border: 1.5px dashed #3d6f86; opacity: 0; pointer-events: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .b { animation: build-in 0.7s var(--ease-out-soft) both; animation-delay: calc(0.55s + var(--i) * 0.16s); }
    .b::after { animation: build-frame 1.1s ease-out both; animation-delay: calc(0.4s + var(--i) * 0.16s); }
  }
  @keyframes build-in {
    0% { opacity: 0; transform: translateY(10px) scale(0.98); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes build-frame {
    0% { opacity: 0; } 25% { opacity: 1; } 100% { opacity: 0; }
  }
  @media (max-width: 1023px) {
    .phone { --rx: 4deg; --ry: -8deg; }
  }
</style>

<script>
  const phone = document.querySelector<HTMLElement>('[data-tilt]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (phone && fine && !calm) {
    const area = phone.closest('section') ?? document.body;
    let tx = 6, ty = -14, cx = 6, cy = -14, raf = 0;
    const loop = () => {
      cx += (tx - cx) * 0.08; cy += (ty - cy) * 0.08;
      phone.style.setProperty('--rx', cx.toFixed(2) + 'deg');
      phone.style.setProperty('--ry', cy.toFixed(2) + 'deg');
      raf = Math.abs(tx - cx) + Math.abs(ty - cy) > 0.02 ? requestAnimationFrame(loop) : 0;
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    area.addEventListener('pointermove', (e) => {
      const r = phone.getBoundingClientRect();
      const dx = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
      const dy = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
      ty = -14 + dx * 22; tx = 6 - dy * 14; kick();
    }, { passive: true });
    area.addEventListener('pointerleave', () => { tx = 6; ty = -14; kick(); });
  }
</script>

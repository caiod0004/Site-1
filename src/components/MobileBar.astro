---
import Icon from './Icon.astro';
import { QUESTIONARIO_URL } from '../config';
---
<div id="mobile-bar" class="fixed inset-x-0 bottom-0 z-40 px-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] pt-3 lg:hidden" data-show="false">
  <a href={QUESTIONARIO_URL} class="btn btn-lime w-full !min-h-[3.4rem] justify-between !px-6 shadow-[0_18px_40px_-10px_rgb(0_0_0/0.8)]">
    <span>Richiedi il tuo sito</span>
    <span class="flex items-center gap-2"><span class="font-serif text-[1.25rem] italic">197 €</span><Icon name="arrow-right" /></span>
  </a>
</div>
<style>
  #mobile-bar { transform: translateY(120%); transition: transform 0.5s var(--ease-out-soft); }
  #mobile-bar[data-show='true'] { transform: none; }
</style>
<script>
  const bar = document.getElementById('mobile-bar')!;
  const hero = document.getElementById('top');
  const end = document.getElementById('richiedi');
  let pastHero = false, atEnd = false;
  const sync = () => { bar.dataset.show = String(pastHero && !atEnd); bar.inert = !(pastHero && !atEnd); };
  if (hero) new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; sync(); }, { threshold: 0 }).observe(hero);
  if (end) new IntersectionObserver(([e]) => { atEnd = e.isIntersecting; sync(); }, { threshold: 0.2 }).observe(end);
  sync();
</script>

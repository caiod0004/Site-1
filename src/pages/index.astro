---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import Icon from '../components/ui/Icon.astro';
import Timeline from '../components/ui/Timeline.astro';
import Faq from '../components/ui/Faq.astro';
import BrowserFrame from '../components/ui/BrowserFrame.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import BookMockup from '../components/ui/BookMockup.astro';
import caio from '../assets/caio_pensieroso.jpg';
import piattiBuffet from '../assets/piatti_buffet.jpg';
import piattiCocktail from '../assets/piatti_cocktail.jpg';
import caterinhoShot from '../assets/portfolio_caterinho.jpg';
import studioShot from '../assets/portfolio_studio_legale.jpg';
import logoTemakinho from '../assets/loghi/temakinho.png';
import logoCacau from '../assets/loghi/cacau.png';
import logoPoke from '../assets/loghi/pokesamba.png';
import logoMarino from '../assets/loghi/marino.png';
import { SEO_HOME, PROVE, STORIA, FAQ_HOME, PORTE } from '../data/home';
import { CATEGORIE } from '../content.config';
import {
  SITE_URL, STATO_STRUMENTI, LIBRO_AMAZON_URL, INSTAGRAM_URL, INSTAGRAM_CATERINHO_URL,
  LINKEDIN_URL, CATERINHO_URL, STUDIO_LEGALE_URL,
} from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const loghi = [
  { src: logoTemakinho, alt: 'Temakinho', h: 'h-10 sm:h-14' },
  { src: logoCacau, alt: 'Cacau Temakeria brasileira', h: 'h-14 sm:h-[4.5rem]' },
  { src: logoPoke, alt: 'Poké Samba', h: 'h-20 sm:h-24' },
  { src: logoMarino, alt: 'Il Marino di Puntaldia', h: 'h-12 sm:h-16' },
];

const strumenti = [
  { titolo: 'Gestionale e controllo dei numeri', stato: STATO_STRUMENTI.gestionale, testo: 'Food cost di ogni piatto partendo dalle fatture reali, prezzi per canale (sala, asporto, delivery, eventi), incassi e margini. Per sapere cosa ti fa guadagnare e cosa ti costa.', href: '/diagnosi-food-cost/', link: 'Diagnosi Food Cost' },
  { titolo: 'CRM su misura', stato: STATO_STRUMENTI.crm, testo: 'Contatti, richieste dal sito, preventivi ed eventi in un solo posto, collegati alla cassa. Per non perdere clienti in una chat di WhatsApp.', href: '/analisi/vendite/', link: 'Analizza le tue vendite' },
  { titolo: 'TocStory', stato: STATO_STRUMENTI.tocstory, testo: 'Il sistema per organizzare e pubblicare i contenuti sui social, pensato per chi ha un’attività e poco tempo.', href: '/sito/', link: 'Prima serve un sito' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE_URL}/#caio`,
    name: 'Caio Machado',
    jobTitle: 'Consulente per la ristorazione e le PMI',
    url: `${SITE_URL}/`,
    image: `${SITE_URL}/og-image.jpg`,
    sameAs: [INSTAGRAM_URL, LINKEDIN_URL].filter(Boolean),
    worksFor: { '@type': 'Organization', name: 'Caterinho', url: CATERINHO_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/#servizio`,
    name: 'Caio Machado – Ristorazione e tecnologia',
    legalName: 'Proverbi 123 di Freitas de Moura Machado Caio',
    vatID: 'IT04668830161',
    url: `${SITE_URL}/`,
    founder: { '@id': `${SITE_URL}/#caio` },
    address: { '@type': 'PostalAddress', addressLocality: 'Bergamo', addressRegion: 'BG', addressCountry: 'IT' },
    areaServed: [{ '@type': 'Country', name: 'Italia' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: '08 Erros que quebram restaurantes e como evitar antes de investir 1 real',
    author: { '@id': `${SITE_URL}/#caio` },
    inLanguage: 'pt-BR',
    datePublished: '2025',
    bookEdition: 'Collana Italian Method, vol. 01',
    url: LIBRO_AMAZON_URL,
    image: `${SITE_URL}/img/libro-copertina.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_HOME.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={SEO_HOME.title} description={SEO_HOME.description} path="/" theme="home" themeColor="#F1F1DB" jsonLd={jsonLd} og="/og-home.jpg">
  <Header
    nav={[{ href: '#storia', label: 'Storia' }, { href: '#strumenti', label: 'Strumenti' }, { href: '#libro', label: 'Libro' }, { href: '/blog/', label: 'Blog' }]}
    cta={{ href: '#analisi', label: 'Fai l’analisi del tuo caso', short: 'Analisi' }} />
  <main id="contenuto">
    <!-- HERO -->
    <section id="top" class="on-paper relative isolate overflow-hidden bg-paper pt-[4.5rem] text-paper-ink">
      <div class="wrap grid items-center gap-14 pb-16 pt-10 md:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] md:gap-10 lg:pb-24 lg:pt-16">
        <div>
          <p class="t-kicker flex items-center gap-3 text-lime-deep"><span class="h-px w-10 bg-current" aria-hidden="true"></span>Caio Machado · Ristorazione e tecnologia</p>
          <h1 class="t-hero mt-6 max-w-[16ch] !text-[clamp(2.7rem,1.3rem+5.4vw,6rem)] !leading-[1.02]">Ho portato il computer in cucina. <span class="em text-lime-deep">Da allora metto in ordine numeri, clienti e presenza online.</span></h1>
          <p class="t-lead mt-7 max-w-[40rem] text-paper-muted">Dal 2009 lavoro nella ristorazione: ho guidato cucine a Milano e a Roma, aperto un locale a Londra e avviato punti vendita da zero. Ho studiato programmazione e web design, e i sistemi che uso li costruisco io. Oggi aiuto ristoranti e piccole imprese a vedere chiaro nei numeri, a vendere meglio e a esistere online.</p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#analisi" class="btn btn-ink">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
            <a href="#storia" class="btn btn-line">Leggi la mia storia</a>
          </div>
          <p class="mt-5 text-[0.95rem] text-paper-muted">Gratuita, su candidatura. Ti rispondo io, di persona.</p>
        </div>
        <figure class="relative mx-auto w-full max-w-[24rem] md:mx-0 md:justify-self-end">
          <span class="absolute -right-3 -top-3 bottom-3 left-3 rounded-t-full border border-lime-deep/50" aria-hidden="true"></span>
          <Image src={caio} alt="Caio Machado, in camicia bianca, con la mano sotto il mento" widths={[400, 640, 830]} sizes="(min-width: 768px) 24rem, 90vw" class="relative aspect-[4/5] w-full rounded-t-full object-cover object-top" loading="eager" fetchpriority="high" />
          <span class="absolute -bottom-4 -left-4 size-16 rounded-full bg-coral/90 mix-blend-multiply" aria-hidden="true"></span>
        </figure>
      </div>
      <div class="border-y border-paper-ink/12">
        <ul class="wrap flex flex-wrap gap-x-7 gap-y-3 py-6 font-display text-[0.95rem] text-paper-ink/85" aria-label="In breve">
          {PROVE.map((p) => <li class="flex items-center gap-3"><span class="size-1.5 rotate-45 bg-coral" aria-hidden="true"></span>{p}</li>)}
        </ul>
      </div>
    </section>

    <!-- STORIA -->
    <section id="storia" class="on-paper bg-paper text-paper-ink" aria-labelledby="storia-t">
      <div class="wrap grid gap-14 py-24 sm:py-32 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <p class="t-kicker text-lime-deep">La mia storia</p>
          <h2 id="storia-t" class="t-h2 mt-4">Non sono nato consulente. <span class="em text-lime-deep">Ci sono arrivato lavorando.</span></h2>
        </div>
        <div style="--tl-bg: var(--color-paper)">
          <Timeline items={STORIA} />
          <blockquote class="mt-16 border-l border-coral pl-6">
            <p class="t-kicker text-paper-muted">Lezione appresa</p>
            <p class="mt-3 font-serif text-[clamp(1.4rem,1.1rem+1.2vw,2.1rem)] leading-[1.2]">Un’attività non si salva con la passione da sola, né con un software comprato. Si salva quando chi la guida sa cosa guadagna su ogni piatto, sa da dove arrivano i clienti e si fa trovare da chi lo cerca. È quello che faccio con te.</p>
          </blockquote>
          <a href="#analisi" class="btn btn-ink mt-10">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="wrap pb-20">
        <div class="border-t border-paper-ink/12 pt-10">
          <p class="t-kicker text-paper-muted">Dove ho lavorato</p>
          <ul class="mt-8 flex flex-wrap items-center gap-x-12 gap-y-8 opacity-80">
            {loghi.map((l) => <li><Image src={l.src} alt={l.alt} widths={[200, 400]} sizes="12rem" class={`w-auto ${l.h}`} loading="lazy" /></li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- CATERINHO -->
    <section class="relative isolate overflow-hidden bg-ink text-ivory" aria-labelledby="lab-t">
      <div class="wrap grid items-center gap-14 py-24 sm:py-32 lg:grid-cols-2 lg:gap-20">
        <div class="relative grid grid-cols-[1.2fr_1fr] items-end gap-4">
          <Image src={piattiBuffet} alt="Un buffet di Caterinho: tartare, sushi e fritture" widths={[400, 700, 930]} sizes="(min-width: 1024px) 22rem, 55vw" class="aspect-[3/4] w-full rounded-[1.5rem] object-cover" loading="lazy" />
          <Image src={piattiCocktail} alt="Una tartare servita in una coppa da cocktail" widths={[300, 560]} sizes="(min-width: 1024px) 18rem, 45vw" class="mb-10 aspect-[3/4] w-full rounded-[1.5rem] object-cover" loading="lazy" />
        </div>
        <div data-reveal>
          <p class="t-kicker text-lime">Caterinho, il mio laboratorio</p>
          <h2 id="lab-t" class="t-h2 mt-4">Non ti porto teorie. <span class="em text-lime-light">Ti porto quello che provo ogni giorno.</span></h2>
          <div class="mt-8 max-w-[38rem] space-y-5 text-ivory/80">
            <p>Caterinho è la mia attività principale: catering ed esperienze nippo-brasiliane a Bergamo. È anche il posto dove metto alla prova ogni sistema prima di proportelo. Lì ogni piatto ha il suo food cost calcolato. Lì ho costruito il sito, i preventivi, il controllo dei numeri e il sistema per i social.</p>
            <p>Non è una storia di successo già finita, e non te la racconto così. È un cantiere aperto: ci sono giorni buoni e decisioni difficili, come in ogni piccola impresa. Proprio per questo so di cosa parlo quando parliamo della tua.</p>
          </div>
          <a href={CATERINHO_URL} target="_blank" rel="noopener" class="btn btn-ghost mt-9">Scopri Caterinho <Icon name="arrow-up-right" /><span class="sr-only">(si apre in una nuova scheda)</span></a>
        </div>
      </div>
    </section>

    <!-- LIBRO -->
    <section id="libro" class="on-paper bg-paper-2 text-paper-ink" aria-labelledby="libro-t">
      <div class="wrap grid items-center gap-16 py-24 sm:py-32 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <BookMockup />
        <div data-reveal>
          <p class="t-kicker text-lime-deep">Il libro</p>
          <h2 id="libro-t" class="t-h2 mt-4">Ho messo per iscritto gli errori. <span class="em text-lime-deep">Anche i miei.</span></h2>
          <div class="mt-8 max-w-[40rem] space-y-5 text-paper-muted">
            <p>Nel 2025 ho pubblicato su Amazon Brasile, in portoghese, <strong class="text-paper-ink">08 Erros que quebram restaurantes e como evitar antes de investir 1 real</strong> (collana Italian Method). È nato come un’iniziativa personale: restituire al mio paese quello che avevo imparato in Italia, e condividere esperienza con chi sogna di aprire un ristorante ma non sa da dove cominciare. Parla degli errori che fanno chiudere un ristorante prima ancora che apra, e di come evitarli: ricerca di mercato, analisi della concorrenza fisica e digitale, marketing digitale, gestione e sprechi, fidelizzazione, prezzo contro valore percepito, espansione troppo veloce. In più, un capitolo bonus sul business plan.</p>
            <p>Non è un manuale scritto da lontano. Dentro ci sono le cucine in cui ho lavorato, il locale in cui ho visto per primo l’occasione del delivery e quello che ho cambiato quando ho aperto Caterinho.</p>
          </div>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={LIBRO_AMAZON_URL} target="_blank" rel="noopener" class="btn btn-ink">Acquista la copia in portoghese <Icon name="arrow-up-right" /><span class="sr-only">(Amazon, si apre in una nuova scheda)</span></a>
            <a href="/risorse/#lista-attesa" class="btn btn-line">Entra in lista d’attesa per l’edizione italiana</a>
          </div>
        </div>
      </div>
    </section>

    <!-- STRUMENTI -->
    <section id="strumenti" class="on-paper bg-paper text-paper-ink" aria-labelledby="strumenti-t">
      <div class="wrap py-24 sm:py-32">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16" data-reveal>
          <div>
            <p class="t-kicker text-lime-deep">Gli strumenti che costruisco</p>
            <h2 id="strumenti-t" class="t-h2 mt-4">Tre strumenti, <span class="em text-lime-deep">nati in cucina, non in un ufficio.</span></h2>
          </div>
          <p class="max-w-[34rem] text-paper-muted lg:pb-2">Non vendo software. Costruisco gli strumenti che servono a me e li adatto a chi lavora come me. Ti dico sempre a che punto sono.</p>
        </div>
        <ul class="mt-14 grid gap-4 lg:grid-cols-3">
          {strumenti.map((s) => (
            <li class="flex flex-col rounded-[1.5rem] bg-paper-3 p-7 shadow-[inset_0_0_0_1px_rgb(42_42_38/0.08)] sm:p-8">
              <span class="self-start"><StatusBadge stato={s.stato} /></span>
              <h3 class="t-h3 mt-8">{s.titolo}</h3>
              <p class="mt-3 text-paper-muted">{s.testo}</p>
              <a href={s.href} class="mt-auto inline-flex min-h-11 items-center gap-2 pt-6 font-display font-medium text-lime-deep underline-offset-4 hover:underline">{s.link} <Icon name="arrow-right" class="size-4" /></a>
            </li>
          ))}
        </ul>
        <p class="mt-12 max-w-[46rem] font-serif text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-[1.2]">Il primo passo è quasi sempre lo stesso: un sito che funzioni. Senza un sito, CRM e social non hanno dove portare i clienti.</p>
      </div>
    </section>

    <!-- ANALISI -->
    <section id="analisi" class="relative isolate overflow-hidden bg-ink text-ivory" aria-labelledby="analisi-t">
      <div class="wrap py-24 sm:py-32">
        <div class="max-w-[52rem]" data-reveal>
          <p class="t-kicker text-lime">Analisi del tuo caso</p>
          <h2 id="analisi-t" class="t-h2 mt-4">Da dove cominciamo? <span class="em text-lime-light">Scegli il problema che ti toglie più sonno.</span></h2>
          <p class="t-lead mt-6 text-ivory/80">Ogni modulo richiede 4 minuti e contiene domande precise, così la prima chiamata parte dai tuoi dati e non da frasi generiche. Leggo io ogni risposta. Se non posso aiutarti, te lo dico.</p>
        </div>
        <ul class="mt-14 grid gap-4 lg:grid-cols-3">
          {PORTE.map((p) => (
            <li class="door group relative flex flex-col rounded-[1.75rem] bg-paper p-7 text-paper-ink sm:p-9">
              <span class="grid size-12 place-items-center rounded-full bg-lime text-paper-ink"><Icon name={p.icon} class="size-6" /></span>
              <h3 class="t-h3 mt-8">{p.titolo}</h3>
              <p class="mt-4 font-serif text-[clamp(1.5rem,1.2rem+1vw,2rem)] italic leading-[1.15]">“{p.frase}”</p>
              <p class="mt-5 text-paper-muted">{p.testo}</p>
              <a href={p.href} class="btn btn-ink mt-auto self-start !mt-8">{p.cta} <Icon name="arrow-right" /></a>
            </li>
          ))}
        </ul>
        <p class="mt-10 max-w-[44rem] text-ivory/75">Lavoro su pochi casi alla volta, perché la mia attività principale resta Caterinho. Se il calendario è pieno, te lo scrivo con una data.</p>
      </div>
    </section>

    <!-- LAVORI -->
    <section id="lavori" class="on-paper bg-paper text-paper-ink" aria-labelledby="lavori-t">
      <div class="wrap py-24 sm:py-32">
        <p class="t-kicker text-lime-deep">Lavori pubblicati</p>
        <h2 id="lavori-t" class="t-h2 mt-4">Lavori veri, <span class="em text-lime-deep">con il loro indirizzo.</span></h2>
        <div class="mt-14 grid gap-14 lg:grid-cols-2 lg:gap-10">
          <article class="min-w-0">
            <BrowserFrame img={caterinhoShot} host="caterinho.it" alt="Schermata del sito di Caterinho: il team davanti al locale, con il logo e il motto “Celebra di più. Preoccupati di meno.”" />
            <h3 class="t-h3 mt-6">Caterinho</h3>
            <p class="mt-1.5 text-paper-muted">Sito, preventivi e sistemi della mia attività.</p>
            <a href={CATERINHO_URL} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center gap-2 font-display font-medium text-lime-deep underline-offset-4 hover:underline">caterinho.it <Icon name="arrow-up-right" class="size-4" /><span class="sr-only">(si apre in una nuova scheda)</span></a>
          </article>
          <article class="min-w-0">
            <BrowserFrame img={studioShot} host={STUDIO_LEGALE_URL ? STUDIO_LEGALE_URL.replace(/^https?:\/\//, '') : 'studiolegaledemouramachado.it'} alt="Schermata del sito dello Studio Legale De Moura Machado: pagina in portoghese sul riconoscimento del diploma brasiliano in Italia." />
            <h3 class="t-h3 mt-6">Studio Legale De Moura Machado</h3>
            <p class="mt-1.5 text-paper-muted">Lo studio di famiglia: sito istituzionale con percorso di qualificazione delle richieste.</p>
            {STUDIO_LEGALE_URL
              ? <a href={STUDIO_LEGALE_URL} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center gap-2 font-display font-medium text-lime-deep">{STUDIO_LEGALE_URL.replace(/^https?:\/\//, '')} <Icon name="arrow-up-right" class="size-4" /></a>
              : <p class="mt-3 flex min-h-11 flex-wrap items-center gap-2 font-display text-paper-muted"><span class="break-all">studiolegaledemouramachado.it</span> <span class="placeholder">[DA PUBBLICARE]</span></p>}
          </article>
        </div>
        <p class="mt-12 max-w-[40rem] text-paper-muted">Le testimonianze dei clienti arriveranno quando ci saranno clienti da far parlare. Non ne metto di finte.</p>
      </div>
    </section>

    <!-- BLOG -->
    <section id="blog" class="on-paper bg-paper-2 text-paper-ink" aria-labelledby="blog-t">
      <div class="wrap py-24 sm:py-28">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
          <div>
            <h2 id="blog-t" class="t-h2">Diario dal <span class="em text-lime-deep">laboratorio</span></h2>
            <p class="mt-5 max-w-[34rem] text-paper-muted">Quello che imparo mentre costruisco Caterinho e i miei strumenti. Errori compresi.</p>
          </div>
          <a href="/blog/" class="inline-flex min-h-11 items-center gap-2 font-display font-medium text-lime-deep underline-offset-4 hover:underline lg:justify-self-end">Tutti gli articoli <Icon name="arrow-right" class="size-4" /></a>
        </div>
        {posts.length > 0 ? (
          <ul class="mt-12 grid gap-4 lg:grid-cols-3">
            {posts.map((p) => (
              <li class="rounded-[1.5rem] bg-paper-3 p-7">
                <p class="t-kicker text-lime-deep">{CATEGORIE[p.data.categoria]}</p>
                <h3 class="t-h3 mt-4"><a href={`/blog/${p.id}/`} class="hover:underline">{p.data.title}</a></h3>
                <p class="mt-3 text-paper-muted">{p.data.description}</p>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-12 flex flex-col gap-4 rounded-[1.5rem] border border-dashed border-paper-ink/25 p-8 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-serif text-[1.6rem] leading-tight">Primi articoli in arrivo.</p>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn-line">Seguimi su Instagram <Icon name="arrow-up-right" /></a>
          </div>
        )}
      </div>
    </section>

    <!-- SEGUIMI -->
    <section class="on-paper bg-paper text-paper-ink" aria-labelledby="seguimi-t">
      <div class="wrap py-24 sm:py-28">
        <h2 id="seguimi-t" class="t-h2">Il cantiere, <span class="em text-lime-deep">giorno per giorno.</span></h2>
        <ul class="mt-12 border-b border-paper-ink/15">
          <li class="border-t border-paper-ink/15"><a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="group flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">Instagram · @chef.caiomachado</span><span class="text-paper-muted">dietro le quinte e stories <Icon name="arrow-up-right" class="inline size-4" /></span></a></li>
          <li class="border-t border-paper-ink/15">{LINKEDIN_URL
            ? <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">LinkedIn</span><span class="text-paper-muted">lavoro, numeri e metodo <Icon name="arrow-up-right" class="inline size-4" /></span></a>
            : <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">LinkedIn <span class="placeholder ml-2 align-middle text-[0.6em]">[URL LINKEDIN – DA CONFERMARE]</span></span><span class="text-paper-muted">lavoro, numeri e metodo</span></div>}</li>
          <li class="border-t border-paper-ink/15"><div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">Caterinho</span><span class="flex flex-wrap gap-x-5 text-paper-muted"><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={CATERINHO_URL} target="_blank" rel="noopener">caterinho.it</a><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={INSTAGRAM_CATERINHO_URL} target="_blank" rel="noopener">Instagram @caterinho.it</a></span></div></li>
        </ul>
      </div>

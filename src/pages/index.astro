<style>
  .door { transition: transform 0.6s var(--ease-out-soft), box-shadow 0.6s var(--ease-out-soft); }
  @media (hover: hover) { .door:hover { transform: translateY(-4px); box-shadow: 0 40px 60px -40px rgb(0 0 0 / 0.6); } }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js-reveal) [data-reveal] { opacity: 0; transform: translateY(14px); transition: opacity 0.9s var(--ease-out-soft), transform 0.9s var(--ease-out-soft); }
    :global(.js-reveal) [data-reveal].in { opacity: 1; transform: none; }
  }
</style>
<script>
  // Rivelazione morbida dei titoli di sezione (solo se il movimento è consentito)
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('js-reveal');
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
  }
</script>

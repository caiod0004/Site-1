---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/ui/Header.astro';
import Footer from '../components/ui/Footer.astro';
import MobileBar from '../components/ui/MobileBar.astro';
import Icon from '../components/ui/Icon.astro';
import Timeline from '../components/ui/Timeline.astro';
import Faq from '../components/ui/Faq.astro';
import StatusBadge from '../components/ui/StatusBadge.astro';
import BookMockup from '../components/ui/BookMockup.astro';
import fotoControluce from '../assets/foto/chef_controluce.jpg';
import fotoGiacca from '../assets/foto/chef_giacca.jpg';
import fotoBar from '../assets/foto/bar_caterinho.jpg';
import fotoSushi from '../assets/foto/sushi_occhiali.jpg';
import fotoTartare from '../assets/foto/tartare_sacapoche.jpg';
import fotoSalsa from '../assets/foto/salsa_caterinho.jpg';
import fotoGuarnizione from '../assets/foto/bar_guarnizione.jpg';
import logoTemakinho from '../assets/loghi/temakinho.png';
import logoCacau from '../assets/loghi/cacau.png';
import logoPoke from '../assets/loghi/pokesamba.png';
import logoMarino from '../assets/loghi/marino.png';
import logoCaterinho from '../assets/loghi/caterinho.png';
import LogoTimeline from '../components/ui/LogoTimeline.astro';
import StepForm from '../components/forms/StepForm.astro';
import { FORMS } from '../data/forms';
import { SEO_HOME, PROVE, STORIA, FAQ_HOME, PORTE } from '../data/home';
import { CATEGORIE } from '../content.config';
import {
  SITE_URL, STATO_STRUMENTI, LIBRO_AMAZON_URL, EBOOK_DIRETTO_URL, PREZZO_EBOOK, INSTAGRAM_URL, INSTAGRAM_CATERINHO_URL,
  LINKEDIN_URL, CATERINHO_URL, PREVENDITA_IT_URL, PREZZO_PREVENDITA_IT, CONSEGNA_PDF,
} from '../config';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const loghi = [
  { logo: logoTemakinho, alt: 'Temakinho', nome: 'Temakinho', ruolo: 'Executive chef', dove: 'Milano, Roma, Londra · 2013–2018', testo: 'Da capo bar a executive chef in un anno e mezzo. Le cucine di Milano (Naviglio, Brera) e di Roma (Monti, Borgo), il catering eventi, il punto di Magenta e l’apertura di Londra Soho.', h: 'max-h-10 sm:max-h-14' },
  { logo: logoCacau, alt: 'Cacau Temakeria brasileira', nome: 'Cacau Temakeria', ruolo: 'Project manager', dove: 'Milano', testo: 'Project manager dell’avviamento: burocrazia, food cost, numeri.' },
  { logo: logoPoke, alt: 'Poké Samba', nome: 'Poke Samba', ruolo: 'Avviamento', dove: 'Milano', testo: 'Avviamento da zero: in un anno da circa 50 m² a un laboratorio centrale e a un secondo punto vendita.', h: 'max-h-[5rem] sm:max-h-[6.4rem]' },
  { logo: logoMarino, alt: 'Il Marino di Puntaldia', nome: 'Il Marino di Puntaldia', ruolo: 'Consultant chef', dove: '2021–2022', testo: 'Consulenza come chef.' },
  { logo: logoCaterinho, alt: 'Caterinho', nome: 'Caterinho', ruolo: 'Oggi', dove: 'Bergamo', testo: 'Il mio laboratorio: catering ed esperienze nippo-brasiliane, nato da zero dalla cucina di casa dopo il Covid.', oggi: true },
];

const prodotti = [
  { href: '/diagnosi-food-cost/', kicker: 'Per ristoranti · 197 €', t: 'Diagnosi Food Cost', d: 'Quanto ti costa davvero ogni piatto e quale ti fa guadagnare.', cls: 'bg-lime text-[#17323d]' },
  { href: '/sito/', kicker: 'Per ogni piccola attività · 197 €', t: 'La tua pagina online in 7 giorni', d: 'Una pagina chiara che ti fa trovare e contattare.', cls: 'bg-ink text-ivory' },
];
const strumenti = [
  { titolo: 'Gestionale e controllo dei numeri', stato: STATO_STRUMENTI.gestionale, testo: 'Food cost di ogni piatto partendo dalle fatture reali, prezzi per canale (sala, asporto, delivery, eventi), incassi e margini. Per sapere cosa ti fa guadagnare e cosa ti costa.', href: '/diagnosi-food-cost/', link: 'Diagnosi Food Cost' },
  { titolo: 'CRM su misura', stato: STATO_STRUMENTI.crm, testo: 'Contatti, richieste dal sito, preventivi ed eventi in un solo posto, collegati alla cassa. Per non perdere clienti in una chat di WhatsApp.', href: '/analisi/vendite/', link: 'Analizza le tue vendite' },
  { titolo: 'TocStory', stato: STATO_STRUMENTI.tocstory, testo: 'Il sistema per organizzare e pubblicare i contenuti sui social, pensato per chi ha un’attività e poco tempo. A breve lo condividerò anche con te.', href: '/sito/', link: 'Prima serve un sito' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${SITE_URL}/#caio`,
    name: 'Caio Machado',
    jobTitle: 'Consulente per la ristorazione e le PMI',
    url: `${SITE_URL}/`,
    image: `${SITE_URL}/og-image.jpg`,
    sameAs: [INSTAGRAM_URL, LINKEDIN_URL].filter(Boolean),
    worksFor: { '@type': 'Organization', name: 'Caterinho', url: CATERINHO_URL },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/#servizio`,
    name: 'Caio Machado – Ristorazione e tecnologia',
    legalName: 'Proverbi 123 di Freitas de Moura Machado Caio',
    vatID: 'IT04668830161',
    url: `${SITE_URL}/`,
    founder: { '@id': `${SITE_URL}/#caio` },
    address: { '@type': 'PostalAddress', addressLocality: 'Bergamo', addressRegion: 'BG', addressCountry: 'IT' },
    areaServed: [{ '@type': 'Country', name: 'Italia' }],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: 'Sal, Pimenta & Planilha: 07 erros que você deve evitar antes de abrir um restaurante',
    author: { '@id': `${SITE_URL}/#caio` },
    inLanguage: 'pt-BR',
    datePublished: '2025',
    bookEdition: 'Collana Italian Method, vol. 01',
    url: LIBRO_AMAZON_URL,
    image: `${SITE_URL}/img/libro-copertina.png`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ_HOME.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
];
---
<Base title={SEO_HOME.title} description={SEO_HOME.description} path="/" theme="home" themeColor="#F1F1DB" jsonLd={jsonLd} og="/og-home.jpg">
  <Header overlay
    nav={[{ href: '#storia', label: 'Storia' }, { href: '#strumenti', label: 'Strumenti' }, { href: '#libro', label: 'Libro' }, { href: '/blog/', label: 'Blog' }]}
    cta={{ href: '#analisi', label: 'Fai l’analisi del tuo caso', short: 'Analisi' }} />
  <main id="contenuto">
    <!-- HERO -->
    <section id="top" class="hero grain relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-ink text-ivory">
      <div class="slides absolute inset-0 -z-20" aria-hidden="true">
        <Image src={fotoControluce} alt="" widths={[640, 960, 1400, 1600]} sizes="100vw" class="slide object-[68%_30%] lg:object-[72%_22%]" loading="eager" fetchpriority="high" />
        <Image src={fotoGiacca} alt="" widths={[640, 960, 1400, 1600]} sizes="100vw" class="slide object-[62%_10%] lg:object-[65%_18%]" loading="eager" />
        <Image src={fotoBar} alt="" widths={[640, 960, 1024]} sizes="100vw" class="slide object-[58%_12%] lg:object-[60%_20%]" loading="eager" />
      </div>
      <div class="shade absolute inset-0 -z-10" aria-hidden="true"></div>
      <div class="wrap relative mt-auto grid gap-10 pb-10 pt-[56svh] md:pb-14 md:pt-[40svh] lg:grid-cols-[minmax(0,1.4fr)_minmax(0,0.6fr)] lg:items-center lg:pt-32">
        <div>
          <p class="t-kicker flex items-center gap-3 text-lime-light"><span class="h-px w-10 bg-current" aria-hidden="true"></span>Caio Machado · Ristorazione e tecnologia</p>
          <h1 class="t-hero mt-5 max-w-[17ch] !text-[clamp(2.5rem,1.4rem+3.6vw,4.7rem)] !leading-[1.02] drop-shadow-[0_2px_24px_rgb(0_0_0/0.35)]">Ho portato il computer in cucina. <span class="em text-lime-light">Da allora metto in ordine numeri, clienti e presenza online.</span></h1>
          <p class="mt-6 max-w-[38rem] text-[1.05rem] leading-relaxed text-ivory/85 sm:text-[1.12rem]">Dal 2009 lavoro nella ristorazione: ho guidato cucine a Milano e a Roma, aperto un locale a Londra e avviato punti vendita da zero. Ho studiato programmazione e web design, e i sistemi che uso li costruisco io. Oggi aiuto ristoranti e piccole imprese a vedere chiaro nei numeri, a vendere meglio e a esistere online.</p>
          <div id="hero-cta" class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href="#analisi" class="btn btn-lime text-[#17323d]">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
            <a href="#storia" class="btn btn-ghost backdrop-blur-sm">Leggi la mia storia</a>
          </div>
          <p class="mt-5 text-[0.95rem] text-ivory/75">Gratuita, su candidatura. Ti rispondo io, di persona.</p>
        </div>
        <figure class="polaroid hidden translate-y-10 self-end justify-self-end lg:block xl:translate-x-10" aria-hidden="true">
          <Image src={fotoSushi} alt="" widths={[300, 500]} sizes="15rem" class="aspect-[3/4] w-[12.5rem] rounded-md object-cover object-[50%_35%]" loading="eager" />
        </figure>
      </div>
    </section>
    <div class="on-paper bg-paper text-paper-ink">
      <div class="border-b border-paper-ink/12">
        <ul class="wrap flex flex-wrap gap-x-7 gap-y-3 py-6 font-display text-[0.95rem] text-paper-ink/85" aria-label="In breve" data-stagger>
          {PROVE.map((p) => <li class="flex items-center gap-3"><span class="size-1.5 rotate-45 bg-coral" aria-hidden="true"></span>{p}</li>)}
        </ul>
      </div>
    </div>

    <!-- STORIA -->
    <section id="storia" class="on-paper bg-paper text-paper-ink" aria-labelledby="storia-t">
      <div class="wrap grid gap-14 py-24 sm:py-32 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div class="lg:sticky lg:top-28 lg:self-start" data-reveal>
          <p class="t-kicker text-lime-deep">La mia storia</p>
          <h2 data-reveal id="storia-t" class="t-h2 mt-4">Non sono nato consulente. <span class="em text-lime-deep">Ci sono arrivato lavorando.</span></h2>
        </div>
        <div style="--tl-bg: var(--color-paper)">
          <Timeline items={STORIA} />
          <blockquote class="mt-16 border-l border-coral pl-6">
            <p class="t-kicker text-paper-muted">Lezione appresa</p>
            <p class="mt-3 font-serif text-[clamp(1.4rem,1.1rem+1.2vw,2.1rem)] leading-[1.2]">Un’attività non si salva con la passione da sola, né con un software comprato. Si salva quando chi la guida sa cosa guadagna su ogni piatto, sa da dove arrivano i clienti e si fa trovare da chi lo cerca. È quello che faccio con te.</p>
          </blockquote>
          <a href="#analisi" class="btn btn-ink mt-10">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
        </div>
      </div>
      <div class="wrap pb-24">
        <div class="grid gap-10 border-t border-paper-ink/12 pt-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
          <div class="lg:sticky lg:top-28 lg:self-start">
            <p class="t-kicker text-lime-deep">Dove ho lavorato</p>
            <h3 data-reveal class="t-h2 mt-4 !text-[clamp(1.9rem,1.3rem+2.2vw,3.2rem)]">Le cucine <span class="em text-lime-deep">che mi hanno formato.</span></h3>
          </div>
          <LogoTimeline items={loghi} />
        </div>
      </div>
    </section>

    <!-- FASCIA FOTO -->
    <section class="band relative isolate overflow-hidden bg-ink text-ivory" aria-label="Prima i clienti, poi le mura">
      <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true"><Image src={fotoTartare} alt="" widths={[800, 1400, 1600]} sizes="100vw" class="h-full w-full object-cover object-[50%_40%]" data-parallax="0.12" loading="lazy" /></div>
      <div class="absolute inset-0 -z-10 bg-[linear-gradient(90deg,rgb(23_50_61/0.92),rgb(23_50_61/0.45)_60%,rgb(23_50_61/0.2))]" aria-hidden="true"></div>
      <div class="wrap py-32 sm:py-44">
        <p class="max-w-[14ch] font-serif text-[clamp(2.6rem,1.6rem+4.4vw,5.5rem)] leading-[1.02]" data-reveal>Prima i clienti, <span class="italic text-lime-light">poi le mura.</span></p>
      </div>
    </section>

    <!-- CATERINHO -->
    <section class="grain relative isolate overflow-hidden bg-ink text-ivory" aria-labelledby="lab-t">
      <div class="wrap grid items-center gap-14 py-24 sm:py-32 lg:grid-cols-2 lg:gap-20">
        <div class="relative grid grid-cols-[1.2fr_1fr] items-end gap-4">
          <Image src={fotoSalsa} alt="Un assaggio di Caterinho rifinito con la salsa, davanti al grembiule con il logo" widths={[400, 700, 930]} sizes="(min-width: 1024px) 22rem, 55vw" class="lift aspect-[3/4] w-full rounded-[1.5rem] object-cover shadow-[0_40px_70px_-40px_rgb(0_0_0/0.8)]" loading="lazy" />
          <Image src={fotoGuarnizione} alt="Caio guarnisce dei cocktail al bancone di Caterinho" widths={[300, 560]} sizes="(min-width: 1024px) 18rem, 45vw" class="lift mb-10 aspect-[3/4] w-full rounded-[1.5rem] object-cover shadow-[0_40px_70px_-40px_rgb(0_0_0/0.8)]" loading="lazy" />
        </div>
        <div data-reveal>
          <Image src={logoCaterinho} alt="Caterinho" widths={[400, 800]} sizes="20rem" class="h-auto w-[min(70vw,20rem)] drop-shadow-[0_18px_40px_rgb(0_0_0/0.45)]" loading="lazy" />
          <p class="t-kicker mt-8 text-lime">Caterinho, il mio laboratorio</p>
          <h2 data-reveal id="lab-t" class="t-h2 mt-4">Non ti porto teorie. <span class="em text-lime-light">Ti porto quello che provo ogni giorno.</span></h2>
          <div class="mt-8 max-w-[38rem] space-y-5 text-ivory/80">
            <p>Caterinho è la mia attività principale: catering ed esperienze nippo-brasiliane a Bergamo. È anche il posto dove metto alla prova ogni sistema prima di proportelo. Lì ogni piatto ha il suo food cost calcolato. Lì ho costruito il sito, i preventivi, il controllo dei numeri e il sistema per i social.</p>
            <p>Non è una storia di successo già finita, e non te la racconto così. È un cantiere aperto: ci sono giorni buoni e decisioni difficili, come in ogni piccola impresa. Proprio per questo so di cosa parlo quando parliamo della tua.</p>
          </div>
          <a href={CATERINHO_URL} target="_blank" rel="noopener" class="btn btn-ghost mt-9">Scopri Caterinho <Icon name="arrow-up-right" /><span class="sr-only">(si apre in una nuova scheda)</span></a>
        </div>
      </div>
    </section>

    <!-- STRUMENTI -->
    <section id="strumenti" class="on-paper bg-paper text-paper-ink" aria-labelledby="strumenti-t">
      <div class="wrap py-24 sm:py-32">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16" data-reveal>
          <div>
            <p class="t-kicker text-lime-deep">Gli strumenti che costruisco</p>
            <h2 data-reveal id="strumenti-t" class="t-h2 mt-4">Tre strumenti, <span class="em text-lime-deep">nati in cucina, non in un ufficio.</span></h2>
          </div>
          <p class="max-w-[34rem] text-paper-muted lg:pb-2">Non vendo software. Costruisco gli strumenti che servono a me e li adatto a chi lavora come me. Ti dico sempre a che punto sono.</p>
        </div>
        <ul class="mt-14 grid gap-4 lg:grid-cols-3" data-stagger>
          {strumenti.map((s) => (
            <li class="lift flex flex-col rounded-[1.5rem] bg-paper-3 p-7 shadow-[inset_0_0_0_1px_rgb(42_42_38/0.08)] sm:p-8">
              <span class="self-start"><StatusBadge stato={s.stato} /></span>
              <h3 class="t-h3 mt-8">{s.titolo}</h3>
              <p class="mt-3 text-paper-muted">{s.testo}</p>
            </li>
          ))}
        </ul>
        <p class="mt-12 max-w-[46rem] font-serif text-[clamp(1.5rem,1.2rem+1vw,2rem)] leading-[1.2]">Il primo passo è quasi sempre lo stesso: un sito che funzioni. Senza un sito, CRM e social non hanno dove portare i clienti.</p>
        <ul class="mt-12 grid gap-4 md:grid-cols-2" data-stagger>
          {prodotti.map((p) => (
            <li><a href={p.href} class={`lift group relative flex h-full flex-col overflow-hidden rounded-[1.75rem] p-7 sm:p-9 ${p.cls}`}>
              <span class="t-kicker opacity-80">{p.kicker}</span>
              <span class="t-h3 mt-4 !text-[clamp(1.6rem,1.2rem+1.4vw,2.3rem)] !leading-[1.05]">{p.t}</span>
              <span class="mt-3 max-w-[30rem] opacity-80">{p.d}</span>
              <span class="mt-8 inline-flex items-center gap-2 font-display font-medium">Scopri <Icon name="arrow-right" class="size-4 transition-transform group-hover:translate-x-1" /></span>
              <span class="pointer-events-none absolute -bottom-10 -right-6 font-display text-[7rem] font-medium leading-none tracking-[-0.06em] opacity-15" aria-hidden="true">197 €</span>
            </a></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- LIBRO -->
    <section id="libro" class="on-paper bg-paper-2 text-paper-ink" aria-labelledby="libro-t">
      <div class="wrap grid items-center gap-16 py-24 sm:py-32 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <BookMockup />
        <div>
          <p class="t-kicker text-lime-deep">Il libro</p>
          <h2 data-reveal id="libro-t" class="t-h2 mt-4">Ho messo per iscritto gli errori. <span class="em text-lime-deep">Anche i miei.</span></h2>
          <figure class="mt-8 border-l-2 border-coral pl-5">
            <blockquote class="font-serif text-[clamp(1.4rem,1.1rem+1vw,1.9rem)] italic leading-[1.2]">«Gli uomini, mentre insegnano, imparano.»</blockquote>
            <figcaption class="mt-2 text-[0.9rem] text-paper-muted">Seneca, <cite>Lettere a Lucilio</cite> (“Homines dum docent discunt”)</figcaption>
          </figure>
          <div class="mt-8 max-w-[40rem] space-y-5 text-paper-muted">
            <p>Questo libro nasce dalla voglia di imparare ancora di più: sono convinto che insegnando si impari due volte. Raccoglie anni di appunti e di studi. L’ho scritto in portoghese, la mia lingua madre, perché è la lingua in cui ho più confidenza. E sto già lavorando alla traduzione in italiano.</p>
            <p><strong class="text-paper-ink">Sal, Pimenta &amp; Planilha: 07 erros que você deve evitar antes de abrir um restaurante</strong> (collana Italian Method, 2025) parla degli errori che fanno chiudere un ristorante prima ancora che apra, e di come evitarli: ricerca di mercato, analisi della concorrenza fisica e digitale, marketing digitale, gestione e sprechi, fidelizzazione, prezzo contro valore percepito, espansione troppo veloce. In più, un capitolo bonus sul business plan.</p>
          </div>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a href={LIBRO_AMAZON_URL} target="_blank" rel="noopener" class="btn btn-ink">Acquista su Amazon (portoghese) <Icon name="arrow-up-right" /><span class="sr-only">(si apre in una nuova scheda)</span></a>
            {EBOOK_DIRETTO_URL
              ? <a href={EBOOK_DIRETTO_URL} target="_blank" rel="noopener" class="btn btn-line">Acquista il manuale digitale{PREZZO_EBOOK && ` · ${PREZZO_EBOOK}`} <span class="opacity-70">· PDF, anche su Kindle</span> <Icon name="arrow-up-right" /></a>
              : <span class="btn btn-line pointer-events-none flex-wrap">Acquista il manuale digitale · PDF <span class="placeholder whitespace-normal">[LINK E PREZZO DEL MANUALE]</span></span>}
            {PREVENDITA_IT_URL && <a href={PREVENDITA_IT_URL} target="_blank" rel="noopener" class="btn btn-line">Edizione italiana in PDF · prevendita {PREZZO_PREVENDITA_IT} <Icon name="arrow-up-right" /></a>}
            <button type="button" class="btn btn-line" aria-expanded="false" aria-controls="lista-attesa" data-wait-btn>Entra in lista d’attesa per l’edizione italiana</button>
          </div>
          <p class="mt-4 text-[0.9rem] text-paper-muted">Manuale digitale (PDF, leggibile anche su Kindle) e copia Amazon: per ora solo in portoghese.{EBOOK_DIRETTO_URL && ` ${CONSEGNA_PDF}`}</p>
          <div id="lista-attesa" class="mt-8 rounded-[1.5rem] bg-paper-3 p-6 sm:p-8" hidden>
            <p class="font-display font-medium">Lista d’attesa per l’edizione italiana</p>
            <p class="mt-1 text-[0.95rem] text-paper-muted">Ricevi una sola email quando è pronta.</p>
            <div class="mt-6"><StepForm def={FORMS.waitlistLibro} /></div>
          </div>
        </div>
      </div>
    </section>

    <!-- ANALISI -->
    <section id="analisi" class="grain relative isolate overflow-hidden bg-ink text-ivory" aria-labelledby="analisi-t">
      <div class="wrap py-24 sm:py-32">
        <div class="max-w-[52rem]" data-reveal>
          <p class="t-kicker text-lime">Analisi del tuo caso</p>
          <h2 data-reveal id="analisi-t" class="t-h2 mt-4">Da dove cominciamo? <span class="em text-lime-light">Scegli il problema che ti toglie più sonno.</span></h2>
          <p class="t-lead mt-6 text-ivory/80">Ogni modulo richiede 4 minuti e contiene domande precise, così la prima chiamata parte dai tuoi dati e non da frasi generiche. Leggo io ogni risposta. Se non posso aiutarti, te lo dico.</p>
        </div>
        <ul class="mt-14 grid gap-4 lg:grid-cols-3" data-stagger>
          {PORTE.map((p) => (
            <li class="door group relative flex flex-col rounded-[1.75rem] bg-paper p-7 text-paper-ink shadow-[0_30px_60px_-40px_rgb(0_0_0/0.7)] sm:p-9">
              <span class="grid size-12 place-items-center rounded-full bg-lime text-paper-ink"><Icon name={p.icon} class="size-6" /></span>
              <h3 class="t-h3 mt-8">{p.titolo}</h3>
              <p class="mt-4 font-serif text-[clamp(1.5rem,1.2rem+1vw,2rem)] italic leading-[1.15]">“{p.frase}”</p>
              <p class="mt-5 text-paper-muted">{p.testo}</p>
              <a href={p.href} class="btn btn-ink mt-auto self-start !mt-8">{p.cta} <Icon name="arrow-right" /></a>
            </li>
          ))}
        </ul>
        <p class="mt-10 max-w-[44rem] text-ivory/75">Lavoro su pochi casi alla volta, perché la mia attività principale resta Caterinho. Se il calendario è pieno, te lo scrivo con una data.</p>
      </div>
    </section>

    <!-- BLOG -->
    <section id="blog" class="on-paper bg-paper-2 text-paper-ink" aria-labelledby="blog-t">
      <div class="wrap py-24 sm:py-28">
        <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
          <div>
            <h2 data-reveal id="blog-t" class="t-h2">Diario dal <span class="em text-lime-deep">laboratorio</span></h2>
            <p class="mt-5 max-w-[34rem] text-paper-muted">Quello che imparo mentre costruisco Caterinho e i miei strumenti. Errori compresi.</p>
          </div>
          <a href="/blog/" class="inline-flex min-h-11 items-center gap-2 font-display font-medium text-lime-deep underline-offset-4 hover:underline lg:justify-self-end">Tutti gli articoli <Icon name="arrow-right" class="size-4" /></a>
        </div>
        {posts.length > 0 ? (
          <ul class="mt-12 grid gap-4 lg:grid-cols-3" data-stagger>
            {posts.map((p) => (
              <li class="rounded-[1.5rem] bg-paper-3 p-7">
                <p class="t-kicker text-lime-deep">{CATEGORIE[p.data.categoria]}</p>
                <h3 class="t-h3 mt-4"><a href={`/blog/${p.id}/`} class="hover:underline">{p.data.title}</a></h3>
                <p class="mt-3 text-paper-muted">{p.data.description}</p>
              </li>
            ))}
          </ul>
        ) : (
          <div class="mt-12 flex flex-col gap-4 rounded-[1.5rem] border border-dashed border-paper-ink/25 p-8 sm:flex-row sm:items-center sm:justify-between">
            <p class="font-serif text-[1.6rem] leading-tight">Primi articoli in arrivo.</p>
            <a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="btn btn-line">Seguimi su Instagram <Icon name="arrow-up-right" /></a>
          </div>
        )}
      </div>
    </section>

    <!-- SEGUIMI -->
    <section class="on-paper bg-paper text-paper-ink" aria-labelledby="seguimi-t">
      <div class="wrap py-24 sm:py-28">
        <h2 data-reveal id="seguimi-t" class="t-h2">Il cantiere, <span class="em text-lime-deep">giorno per giorno.</span></h2>
        <ul class="mt-12 border-b border-paper-ink/15">
          <li class="border-t border-paper-ink/15"><a href={INSTAGRAM_URL} target="_blank" rel="noopener" class="group flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">Instagram · @chef.caiomachado</span><span class="text-paper-muted">dietro le quinte e stories <Icon name="arrow-up-right" class="inline size-4" /></span></a></li>
          <li class="border-t border-paper-ink/15">{LINKEDIN_URL
            ? <a href={LINKEDIN_URL} target="_blank" rel="noopener" class="flex min-h-11 flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">LinkedIn</span><span class="text-paper-muted">lavoro, numeri e metodo <Icon name="arrow-up-right" class="inline size-4" /></span></a>
            : <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">LinkedIn <span class="placeholder ml-2 align-middle text-[0.6em]">[URL LINKEDIN – DA CONFERMARE]</span></span><span class="text-paper-muted">lavoro, numeri e metodo</span></div>}</li>
          <li class="border-t border-paper-ink/15"><div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-6"><span class="t-h3">Caterinho</span><span class="flex flex-wrap gap-x-5 text-paper-muted"><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={CATERINHO_URL} target="_blank" rel="noopener">caterinho.it</a><a class="inline-flex min-h-11 items-center underline-offset-4 hover:underline" href={INSTAGRAM_CATERINHO_URL} target="_blank" rel="noopener">Instagram @caterinho.it</a></span></div></li>
        </ul>
      </div>
    </section>

    <Faq items={FAQ_HOME} />

    <!-- CHIUSURA -->
    <section id="chiusura" class="grain relative isolate overflow-hidden bg-ink text-ivory" aria-labelledby="chiusura-t">
      <div class="wrap flex flex-col items-center py-28 text-center sm:py-36">
        <h2 data-reveal id="chiusura-t" class="t-hero max-w-[18ch] !text-[clamp(2.4rem,1.2rem+4.4vw,5rem)] !leading-[1.05]">Raccontami il tuo caso. <span class="em text-lime-light">Ti dico la verità, anche se la verità è “non ti serve ancora”.</span></h2>
        <a href="#analisi" class="btn btn-lime mt-10 !min-h-14 !px-8 text-[#2a2a26]">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
      </div>
    </section>
  </main>
  <Footer />
  <MobileBar href="#analisi" label="Fai l’analisi del tuo caso" showAfter="hero-cta" hideAt="analisi,chiusura" />
</Base>

<script>
  const wb = document.querySelector<HTMLButtonElement>('[data-wait-btn]');
  const wl = document.getElementById('lista-attesa');
  wb?.addEventListener('click', () => { const open = wb.getAttribute('aria-expanded') !== 'true'; wb.setAttribute('aria-expanded', String(open)); wl!.hidden = !open; if (open) wl!.querySelector<HTMLElement>('input:not([type=hidden])')?.focus(); });
</script>

---
import Base from '../../layouts/Base.astro';
import Header from '../../components/ui/Header.astro';
import Hero from '../../components/sito/Hero.astro';
import Marquee from '../../components/ui/Marquee.astro';
import TearEdge from '../../components/ui/TearEdge.astro';
import Recognize from '../../components/sito/Recognize.astro';
import Problem from '../../components/sito/Problem.astro';
import Offer from '../../components/sito/Offer.astro';
import Steps from '../../components/sito/Steps.astro';
import Work from '../../components/sito/Work.astro';
import Ladder from '../../components/sito/Ladder.astro';
import About from '../../components/sito/About.astro';
import Fit from '../../components/sito/Fit.astro';
import Price from '../../components/sito/Price.astro';
import Where from '../../components/sito/Where.astro';
import Faq from '../../components/sito/Faq.astro';
import Closing from '../../components/sito/Closing.astro';
import Footer from '../../components/ui/Footer.astro';
import MobileBar from '../../components/ui/MobileBar.astro';
import { SEO, FAQ, VANTAGGI } from '../../data/content';
import { SITE_URL, QUESTIONARIO_URL } from '../../config';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': `${SITE_URL}/sito/#servizio`,
    name: 'Caio Machado · siti per attività',
    alternateName: 'Proverbi 123',
    description: SEO.description,
    url: `${SITE_URL}/sito/`,
    image: `${SITE_URL}/og-image.jpg`,
    founder: { '@type': 'Person', name: 'Caio Machado' },
    legalName: 'Proverbi 123 di Freitas de Moura Machado Caio',
    vatID: 'IT04668830161',
    address: { '@type': 'PostalAddress', addressLocality: 'Bergamo', addressRegion: 'BG', addressCountry: 'IT' },
    areaServed: [{ '@type': 'Country', name: 'Italia' }, { '@type': 'City', name: 'Bergamo' }],
    priceRange: '197 €',
    makesOffer: {
      '@type': 'Offer',
      name: 'Sito web di una pagina, online in 7 giorni lavorativi',
      price: '197',
      priceCurrency: 'EUR',
      availability: 'https://schema.org/LimitedAvailability',
      itemOffered: { '@type': 'Service', name: 'Sito di una pagina per piccole attività', serviceType: 'Realizzazione sito web' },
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a.replace('[PREZZO DEL CANONE]', '').trim() },
    })),
  },
];
---
<Base title={SEO.title} description={SEO.description} path="/sito/" jsonLd={jsonLd} theme="sito" themeColor="#1C1C19">
  <Header sub="siti per attività"
    nav={[{ href: '#cosa-ricevi', label: 'Cosa ricevi' }, { href: '#come-funziona', label: 'Come funziona' }, { href: '#lavori', label: 'Lavori' }, { href: '#prezzo', label: 'Prezzo' }]}
    cta={{ href: QUESTIONARIO_URL, label: 'Richiedi il tuo sito', short: 'Richiedi' }} />
  <main id="contenuto">
    <Hero />
    <Marquee items={VANTAGGI} />
    <Recognize />
    <TearEdge from="var(--color-paper)" to="var(--color-ink)" rim="rgb(241 241 219 / 0.12)" seed={11} />
    <Problem />
    <Offer />
    <Steps />
    <TearEdge from="var(--color-ink)" to="var(--color-paper)" rim="rgb(205 180 108 / 0.35)" seed={5} />
    <Work />
    <Ladder />
    <About />
    <Fit />
    <Price />
    <Where />
    <Faq />
    <Closing />
  </main>
  <Footer extra="Un progetto TocStory." />
  <MobileBar href={QUESTIONARIO_URL} label="Richiedi il tuo sito" price="197 €" hideAt="richiedi" />
</Base>

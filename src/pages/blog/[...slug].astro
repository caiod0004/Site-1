---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Header from '../../components/ui/Header.astro';
import Footer from '../../components/ui/Footer.astro';
import Icon from '../../components/ui/Icon.astro';
import { CATEGORIE } from '../../content.config';
import { SITE_URL } from '../../config';
export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
const cta = { gestione: ['/analisi/gestione/', 'gestione e numeri'], online: ['/analisi/online/', 'presenza online'], vendite: ['/analisi/vendite/', 'vendite e clienti'] }[post.data.porta];
const url = `${SITE_URL}/blog/${post.id}/`;
const jsonLd = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: post.data.title, description: post.data.description,
  datePublished: post.data.date.toISOString(), author: { '@type': 'Person', name: 'Caio Machado', url: `${SITE_URL}/` },
  mainEntityOfPage: url, image: `${SITE_URL}/og-image.jpg`, inLanguage: 'it',
}];
---
<Base title={`${post.data.title} | Caio Machado`} description={post.data.description} path={`/blog/${post.id}/`} theme="home" themeColor="#F1F1DB" ogType="article" jsonLd={jsonLd}>
  <Header nav={[{ href: '/blog/', label: 'Diario' }]} cta={{ href: cta[0], label: 'Fai l’analisi del tuo caso', short: 'Analisi' }} />
  <main id="contenuto" class="on-paper bg-paper pt-[4.5rem] text-paper-ink">
    <article id="top" class="wrap max-w-[46rem] pb-24 pt-12 sm:pt-20">
      <a href="/blog/" class="inline-flex min-h-11 items-center gap-2 text-paper-muted hover:underline"><Icon name="arrow-left" class="size-4" />Diario dal laboratorio</a>
      <p class="t-kicker mt-8 text-lime-deep">{CATEGORIE[post.data.categoria]} · <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time></p>
      <h1 class="t-h2 mt-4">{post.data.title}</h1>
      <div class="prosa mt-10"><Content /></div>
      <aside class="mt-16 rounded-[1.75rem] bg-ink p-8 text-ivory">
        <p class="font-serif text-[1.6rem] leading-tight">Vuoi applicarlo alla tua attività?</p>
        <a href={cta[0]} class="btn btn-lime mt-6 text-[#2a2a26]">Fai l’analisi del tuo caso <Icon name="arrow-right" /></a>
        <p class="mt-3 text-[0.9rem] text-ivory/70">Area: {cta[1]}.</p>
      </aside>
    </article>
  </main>
  <Footer />
</Base>
<style>
  .prosa :global(p), .prosa :global(li) { font-size: 1.1rem; line-height: 1.75; color: var(--color-paper-ink); }
  .prosa :global(p + p) { margin-top: 1.2em; }
  .prosa :global(h2) { font-family: var(--font-head); font-size: 2rem; margin: 1.6em 0 0.5em; }
  .prosa :global(a) { color: var(--color-lime-deep); text-decoration: underline; }
  .prosa :global(ul) { list-style: disc; padding-left: 1.2em; margin: 1em 0; }
</style>
